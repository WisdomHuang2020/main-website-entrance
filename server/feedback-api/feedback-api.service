[Unit]
Description=站群留言板 API（llc / interleavedpfc / ahb / optical / web-training）
Documentation=https://github.com/WisdomHuang2020/main-website-entrance/tree/main/server/feedback-api
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/feedback-api

Environment=NODE_ENV=production
Environment=PORT=8792
Environment=DB_PATH=/var/lib/feedback-api/data.db
Environment=COOKIE_SECURE=1

ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/feedback-api/index.mjs

Restart=always
RestartSec=3

User=www-data
Group=www-data

# ── 进程加固（与 widget-api 同一套；理由见其 unit 注释）──
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/feedback-api
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native

# 注：刻意不加 MemoryDenyWriteExecute —— V8 的 JIT 需要可写可执行内存，
#     开启该项会导致 Node 启动即崩溃（widget-api 部署时实测过）。

[Install]
WantedBy=multi-user.target
